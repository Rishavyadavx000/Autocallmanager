# Copy to .env and fill in before running in anything but a quick local test.
# This file is loaded manually (see README) — Node does not read .env automatically
# unless you run with `node --env-file=.env src/server.js` (Node 20.6+).

# Port the HTTP(S) API listens on.
PORT=8787

# Where the SQLite file and WAL live. Defaults to ./data next to this file.
DATA_DIR=./data

# First-run admin account. If ADMIN_BOOTSTRAP_PASSWORD is omitted, a random
# password is generated and printed ONCE to the server console on first boot.
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=

# Admin session lifetime.
SESSION_TTL_HOURS=12

# Optional shared secret the mobile app can send as `X-App-Key` on the public
# GET /v1/prompts endpoints. This is a basic abuse-limiter, NOT real security —
# any value baked into the APK can be extracted by decompiling it. Leave blank
# to keep the public catalog fully open (the default, and what the V1.0.4
# prompt contract assumes).
PUBLIC_APP_KEY=

# Optional: lets the admin panel's "Test" button actually call Gemini instead
# of only rendering the template locally. Uses a server-side key, separate
# from any key end users configure on-device.
GEMINI_API_KEY=
GEMINI_TEST_MODEL=gemini-2.5-flash-lite

# Optional: terminate TLS directly in this process instead of behind a
# reverse proxy / platform load balancer. Most deployments should leave these
# unset and let the hosting platform (Render, Railway, Fly, nginx+certbot...)
# handle HTTPS instead.
TLS_CERT_PATH=
TLS_KEY_PATH=
